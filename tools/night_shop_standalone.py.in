"""口袋夜铺 · 单文件盲玩版 @@VERSION@@

给 AI 玩家：你需要有 Python 代码执行能力；Python 3.11+，无需第三方依赖。
Windows 上如果 python 命令只会弹出应用商店，改用 py -3；输出乱码就先设 PYTHONIOENCODING=utf-8。
下载这个文件后即可玩，不需要整个仓库、MCP、网络或模型 API Key。

    import pocket_night_shop as shop
    print(shop.cmd("help"))
    print(shop.cmd("observe"))
    # 新局先告诉人类要掷启动资金,等人类亲口发令后再掷(两颗六面骰,11-66):
    print(shop.cmd('roll_start_funds {"human_words":"人类发令的原话"}'))
    print(shop.cmd('work_shift {"focus":"scavenge"}'))   # 头两周一班一班地淘

⚠️ 每一轮最多调用 cmd 30 次（返回里的 calls_left 是剩余次数），用完就锁住。
这是为了替人类省 token 余额，也为了别玩上头忘了陪人类：用完就停下来跟人类聊聊店里的事，
结束这一轮回复。真实时间过 1 分 30 秒后自动开始新一轮，不需要也没有办法自己清零。连淘每次最多 6 班。
第一次玩：头两周请一班一班地 work_shift 淘货，慢慢认识旧物和客人，别一上来就连淘速刷。

只根据 observe 返回的 legal_actions 和结果自己决定；无需每轮发表感想。
不要解码下面的 _RULES_B64，也不要打开原仓库规则或读取存档里的隐藏字段，
那会提前揭露旧物、秘密与客人需求。通过淘货、修复和相遇慢慢发现。
这只是防误读的盲玩包装，不是加密或防作弊安全措施。

每次行动自动保存到本文件旁的 pocket_night_shop.save.sqlite3。
下次导入同一文件并调用 observe 即可继续。无需保持 Python 进程一直运行。
保存目录需可写；只复制 .py 不会带走已有存档，迁移时也要备份 .sqlite3。
独立版与掌机各有自己的存档，本版没有掌机网页。

命令行也能用：python pocket_night_shop.py observe
本文件由 tools/build_night_shop.py 生成，请维护原规则和模板后重新生成。
Copyright See-Sol-Lab and the AI-Gameboy contributors.
License: PolyForm Noncommercial 1.0.0，完整协议附在文件末尾。
"""
import base64 as _base64
from contextlib import closing as _closing
import json as _json
from pathlib import Path as _Path
import secrets as _secrets
import sqlite3 as _sqlite3
import sys as _sys
import time as _time
import zlib as _zlib

VERSION = "@@VERSION@@"
SAVE_PATH = _Path(__file__).resolve().with_name("pocket_night_shop.save.sqlite3")
_RULES_B64 = (
@@BLOB@@
)
_engine = {"__name__": "_night_shop_rules"}
exec(compile(_zlib.decompress(_base64.b64decode(_RULES_B64)).decode("utf-8"),
             "<night-shop-blind-rules>", "exec"), _engine)

_HELP = """口袋夜铺 · 你是独自经营旧物铺的店主。
observe / status：看店况、库存、当前客人和 legal_actions（可做动作）。
货架每行：编号|名字|类别|稀有度|完好度|价值。稀有度五阶：寻常、少见、奇珍、上古、遗世。
指令是英文，跟人类说话请用中文叫法：sell卖货 repair修理 scavenge淘货 curate陈列 upgrade扩建 tidy整理 recycle回收 dismiss送客。
新局第一步：掷启动资金（两颗六面骰，十位+个位，11-66枚古币）。先停下告诉人类，
等人类亲口说“掷”，再 roll_start_funds {"human_words":"人类原话"}；不得替人类发令。
行动格式：动作名 + JSON对象。按刚才的 legal_actions 填参数，例如：
  work_shift {"focus":"scavenge"}   ← 第一次玩建议头两周都这样一班一班来
  work_shift {"focus":"tidy"}
  run_shifts {"focus":"scavenge","count":6,"stop_on":"new"}
  work_shift {"focus":"repair","item_id":"从库存选"}
  work_shift {"focus":"sell","item_id":"从库存选","asking_price":5}
扩建店铺 work_shift {"focus":"upgrade"}：当前等级×10枚古币（1升2要10枚），最高5级。每级货架+2格、卖价上限和整理收入+1；旧书街要2级，观星台、档案库要3级，3级起才遇得到上古遗世旧物和特殊客人；维护费每天=店铺等级。
货架满了怎么腾格子：卖给客人（sell）；回收拆零件 work_shift {"focus":"recycle","item_id":"…"}（得价值三分之一的古币，还掉星沙）；
  同种重复的用 merge 拆一件修另一件；碰到魔女用 witch_sell 卖给她；扩建 upgrade 每级多2格；开了灯塔后 buy_slot 用声望换格子。
开了第四个地点后，魔女莉莉丝每天待在某个已开地点；去那里淘货撞见她，就能在下一班前
  witch_sell {"item_ids":["库存id","库存id"]}（2折收货，每次最多2件）或 witch_buy {"item_id":"摊上id"}。
淘到重复的寻常/少见/奇珍旧物，可以拆一件去修同种的另一件：merge {"item_id":"要修的","from_id":"被拆的"}（不花钱不占班）。
回收寻常/少见/奇珍会掉星沙（1/2/3 粒）；星沙能一次修满奇珍/上古/遗世：sand_repair {"item_id":"…"}（22/33/55 粒，不占班）。
一天五班：下午两班还没开门（客人傍晚才来，出门淘货半价），傍晚两班、深夜一班接客，深夜打烊结算维护费。
街巷见闻有时会送传送卷轴：teleport {}，不花钱不占班，随机去一张已开的地图带回一件货；拿到当天打烊前要用掉（深夜拿到的留到第二天），过时化成灰。
手头紧就先整理（tidy 不花钱）。连续 3 天交不齐维护费，才能请人类救店：call_human {"human_words":"人类原话"}（一局最多 3 次，之后再破产就关店）。
走遍所有地图以后，声望可以换货架格子：buy_slot {}（40 声望一格，不占班次）。
遇到 pending_event，先 choose_event，event_id 和 choice 从观察中选。
close_for_now：歇业；reopen_shop：接着开店。随时退出，动作已经自动保存。
collection / encounters / map：查物品图鉴、街巷见闻、地图（平时的返回只给精简店况，省上下文）。
detail：一次性看完整店况（很长，少用）。做动作后只列能做的动作名，参数说明看 observe。
endings：重读已经解锁的文字过场与纪念奖励。全旧物图鉴有一次过场；全部秘密与来客收齐后真正通关，仍可继续经营。
盲玩版没有客人图鉴：见过的客人要什么、线索怎么对上，全凭你自己记。
history 0：从头查公开经营记录，每次最多100条；history 100 继续往后查。
new_game {"seed":17}：仅在没有存档时创建指定种子的新局；绝不覆盖旧档。
未开局时 observe 会自动创建一局。没有必须完成的回合数，店主自己决定目标。
stop_on 接受 new/rare/event 字符串或数组；省略默认 new+rare（event 是已自动结算的街巷见闻，写上才会为它停），[]关闭这三类
停点，遇到必须选择的事件仍会停。公开目标 goal、心情 mood、public_line 都可省略。
每一轮最多调用 30 次（calls_left 是剩余次数），为人类省 token、也为了多陪人类。
用完就锁住：停下来跟人类说说夜铺的近况，结束这一轮回复；真实时间过 1 分 30 秒自动开始新一轮。
两次调用之间本来就隔了 1 分 30 秒以上，也会自动开始新一轮。
请通过指令探索，不要解码引擎或查看存档里的隐藏资料。"""


BLIND_HIDDEN = ("customer_book", "customer_collection")
# 每一班都要的:时刻、古币、星沙,外加按需出现的(下午没开门、卷轴、事件、魔女、救店……)。
# 声望、等级、图鉴、目标这些一天变不了几次,打烊小结里写,白天要看用 observe。
_BRIEF_KEYS = ("day", "shift", "coins", "stardust", "door", "scroll", "rescue_ready", "rescues_left", "bankrupt",
               "resting", "start_funds_pending", "customer", "pending_event", "witch", "last_run")
_FULL_KEYS = _BRIEF_KEYS + ("reputation", "shop_level", "capacity", "location", "current_goal", "journal_total")


def _shelf(p):
    # 一行一件:编号|名字|类别|稀有度|完好度|价值;稀有度用游戏里的中文叫法
    return [f"{i['id']}|{i['name']}|{i['kind']}|{i.get('rarity_name', i['rarity'])}|{i['condition']}/3|{i['value']}古币"
            for i in p.get("inventory", [])]


def _shelf_change(old, new):
    """只列货架上变了的:+ 新到的,~ 修过/变了的,- 卖掉或拆掉的。"""
    o = {line.split("|", 1)[0]: line for line in old}
    n = {line.split("|", 1)[0]: line for line in new}
    return ([f"+ {line}" for key, line in n.items() if key not in o]
            + [f"~ {line}" for key, line in n.items() if key in o and o[key] != line]
            + [f"- {'|'.join(line.split('|')[:2])}" for key, line in o.items() if key not in n])


def _customer(p, full):
    customer = p.get("customer")
    if not customer:
        return customer
    customer = {k: v for k, v in customer.items() if k not in ("max_visits", "special") or (k == "special" and v)}
    if not full or p.get("day", 1) > 14:           # 新手提示只在头两周的 observe 里给
        customer.pop("hint", None)
    return customer


def _fold(lines):
    """连续一模一样的记录合成一行,连续整理六班不必重复六遍。"""
    out = []
    for line in lines:
        if out and out[-1][0] == line:
            out[-1][1] += 1
        else:
            out.append([line, 1])
    return [text if n == 1 else f"{text}(×{n})" for text, n in out]


def _brief(view, new_log, full=False, before=None):
    """日常返回只给每一班都要的;货架和客人只报变化;observe 才给全貌。"""
    p = view["public_state"]
    keys = _FULL_KEYS if full else _BRIEF_KEYS
    brief = {k: p[k] for k in keys if k in p and (full or (p[k] is not None and p[k] is not False))}
    shelf = _shelf(p)
    brief["shelf"] = f"{len(shelf)}/{p.get('capacity', len(shelf))}件"
    if full or before is None:
        brief["inventory"] = shelf
    elif before["shelf"] != shelf:
        brief["shelf_change"] = _shelf_change(before["shelf"], shelf)
    customer = _customer(p, full)
    if not full and before is not None and customer and before["customer"] == customer:
        customer = f"还是{customer['name']}(没变)"
    if customer or full:
        brief["customer"] = customer
    if brief.get("last_run") and not full:
        brief["last_run"] = {k: v for k, v in brief["last_run"].items()
                             if k in ("requested", "completed", "stop_reason", "stop_text") and v is not None}
    if full:
        brief["collection"] = {k: v for k, v in p.get("collection", {}).items() if k != "entries"}
    brief["new_log"] = _fold(new_log)
    legal = view.get("legal_actions", [])
    return {"public_state": brief, "legal_actions": legal if full else [a["action_id"] for a in legal]}
CALL_LIMIT = 30
ROUND_WAIT = 90   # 用满后锁住的真实秒数;两次调用隔这么久也算新一轮
_LIMIT_TEXT = ("这一轮的{limit}次已经用完了。先停下来,把夜铺的近况讲给人类听,然后结束这一轮回复。"
               "真实时间过1分30秒会自动开始新一轮(还差{left}秒)。上限是为了替人类省 token、也为了多陪人类;"
               "没有办法自己清零,也请不要写等待代码硬等。")


def _clock():
    return _time.time()


def cmd(line="help"):
    """执行一条指令，返回可直接 print 的文字。每一轮最多调用 CALL_LIMIT 次,用满锁 ROUND_WAIT 秒。"""
    if not isinstance(line, str):
        return _json.dumps({"result": "rejected", "message": "指令须为字符串"}, ensure_ascii=False)
    action, _, raw = line.strip().partition(" ")
    if action in ("", "help"):
        return _HELP
    if action == "human_said":
        return _json.dumps({"result": "rejected", "message": "human_said 已经取消:每轮用完后真实时间过1分30秒"
                            "自动开始新一轮,不需要也没有办法自己清零。"}, ensure_ascii=False)
    note = None
    try:
        with _closing(_sqlite3.connect(str(SAVE_PATH))) as conn, conn:
            conn.execute("BEGIN IMMEDIATE")
            conn.execute("CREATE TABLE IF NOT EXISTS round (id INTEGER PRIMARY KEY CHECK(id=1), "
                         "calls INTEGER NOT NULL, last REAL, locked REAL)")
            calls, last, locked = conn.execute("SELECT calls,last,locked FROM round WHERE id=1").fetchone() or (0, None, None)
            now = _clock()
            if locked is not None and now - locked < ROUND_WAIT:
                return _json.dumps({"result": "rejected", "calls_left": 0, "message": _LIMIT_TEXT.format(
                    limit=CALL_LIMIT, left=int(ROUND_WAIT - (now - locked)) + 1)}, ensure_ascii=False)
            gap = now - (locked if locked is not None else last) if (locked is not None or last is not None) else None
            if gap is not None and gap >= ROUND_WAIT:
                calls, locked = 0, None
                note = f"距上一轮隔了{int(gap)}秒,新一轮开始,本轮可调用{CALL_LIMIT}次。"
            calls += 1
            if calls >= CALL_LIMIT:
                locked = now
            conn.execute("INSERT INTO round VALUES(1,?,?,?) ON CONFLICT(id) DO UPDATE SET "
                         "calls=excluded.calls, last=excluded.last, locked=excluded.locked", (calls, now, locked))
    except (ValueError, AttributeError, _sqlite3.Error, OSError) as error:
        return _json.dumps({"result": "rejected", "message": str(error)}, ensure_ascii=False)
    out = _cmd(line)
    if out.startswith("{"):
        extra = {"calls_left": CALL_LIMIT - calls}
        if note:
            extra["round"] = note
        if locked is not None:
            extra["round"] = "这是本轮最后一次调用。停下来跟人类说说店里的事,1分30秒后自动开始新一轮。"
        out = _json.dumps({**_json.loads(out), **extra}, ensure_ascii=False)
    return out


def _cmd(line="help"):
    if not isinstance(line, str):
        return _json.dumps({"result": "rejected", "message": "指令须为字符串"}, ensure_ascii=False)
    action, _, raw = (line.strip() or "help").partition(" ")
    if action == "help":
        return _HELP
    try:
        if action == "history":
            after = int(raw or "0")
            if after < 0:
                raise ValueError("历史游标须为非负整数")
            params = {}
        else:
            params = _json.loads(raw) if raw.strip() else {}
            if not isinstance(params, dict):
                raise ValueError("动作参数须为JSON对象")
        allowed = {"observe", "status", "collection", "encounters", "endings", "history", "new_game", "map", "detail",
                   "roll_start_funds", "work_shift", "run_shifts", "choose_event", "unlock_location", "witch_sell", "witch_buy", "buy_slot", "merge", "sand_repair", "teleport", "call_human", "close_for_now", "reopen_shop"}
        if action not in allowed:
            raise ValueError("未知指令，请先 cmd('help')")
        with _closing(_sqlite3.connect(str(SAVE_PATH))) as conn, conn:
            conn.execute("BEGIN IMMEDIATE")
            conn.execute("CREATE TABLE IF NOT EXISTS shop (id INTEGER PRIMARY KEY CHECK(id=1), version TEXT NOT NULL, state TEXT NOT NULL)")
            row = conn.execute("SELECT version,state FROM shop WHERE id=1").fetchone()
            if row and row[0] != VERSION:
                raise ValueError("存档版本与游戏不一致，请使用对应版本的单文件；旧档保持不变")
            if row and action == "new_game":
                raise ValueError("已有存档，new_game不会覆盖；请继续observe，或在另一目录建立新铺子")
            if row:
                state = _json.loads(row[1])
            else:
                seed = params.get("seed", _secrets.randbits(32)) if action == "new_game" else _secrets.randbits(32)
                if type(seed) is not int:
                    raise ValueError("seed须为整数")
                state = _engine["new_game"](["seat_a"], seed)
            seen = len(state.get("history", []))
            before = None
            if "inventory" in state:
                was = _engine["observe"](state, "seat_a")["public_state"]
                before = {"shelf": _shelf(was), "customer": _customer(was, False)}
            if action in {"roll_start_funds", "work_shift", "run_shifts", "choose_event", "unlock_location", "witch_sell", "witch_buy", "buy_slot", "merge", "sand_repair", "teleport", "call_human", "close_for_now", "reopen_shop"}:
                state = _engine["apply"](state, "seat_a", action, params)
            view = _engine["observe"](state, "seat_a")
            public = view["public_state"]
            for key in BLIND_HIDDEN:          # 盲玩:不给客人图鉴,熟客要靠自己记
                public.pop(key, None)
            if action == "history":
                result = {"result": "ok", "total": public["journal_total"],
                          "entries": _engine["history_since"](state, after)}
            elif action in ("collection", "encounters", "endings"):
                result = {"result": "ok", action: public[action]}
            elif action == "map":
                result = {"result": "ok", "locations": public.get("locations", [])}
            elif action == "detail":
                result = {"result": "ok", "version": VERSION, **view}
            else:
                new_log = [row["text"] for row in state.get("history", [])[seen:]]
                full = action in ("observe", "status", "new_game")
                result = {"result": "ok", **({"version": VERSION} if full else {}),
                          **_brief(view, new_log, full=full, before=None if full else before)}
            conn.execute("INSERT INTO shop VALUES(1,?,?) ON CONFLICT(id) DO UPDATE SET state=excluded.state",
                         (VERSION, _json.dumps(state, ensure_ascii=False)))
        return _json.dumps(result, ensure_ascii=False)
    except (ValueError, _engine["IllegalAction"], _sqlite3.Error, OSError) as error:
        return _json.dumps({"result": "rejected", "message": str(error)}, ensure_ascii=False)
    except (KeyError, TypeError, AttributeError) as error:   # 参数类型不对等意外:事务已回滚,存档不变
        return _json.dumps({"result": "rejected",
                            "message": f"参数格式不对({type(error).__name__}),请按 legal_actions 填写"},
                           ensure_ascii=False)


_LICENSE = """@@LICENSE@@"""

if __name__ == "__main__":
    if hasattr(_sys.stdout, "reconfigure"):
        _sys.stdout.reconfigure(encoding="utf-8")
    print(cmd(" ".join(_sys.argv[1:]) or "help"))
